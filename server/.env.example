# ─────────────────────────────────────────────────────────────
#  Primary API (pyRofex) — acción GGAL (BYMA) + futuros GGAL (ROFX)
#  OBLIGATORIO. Credenciales de tu broker en Primary (broker Veta).
# ─────────────────────────────────────────────────────────────
PRIMARY_USER=
PRIMARY_PASS=
PRIMARY_ACCOUNT=

# URLs de Primary (Producción - broker Veta)
PRIMARY_REST_URL=https://api.veta.xoms.com.ar/
PRIMARY_WS_URL=wss://api.veta.xoms.com.ar/

# ─────────────────────────────────────────────────────────────
#  Instrumentos GGAL
# ─────────────────────────────────────────────────────────────
# Ticker de la acción en BYMA (se descubren los plazos CI y 24hs solos).
GGAL_EQUITY_TICKER=GGAL
# marketId de los futuros en Primary.
GGAL_FUTURES_MARKET=ROFX
# Plazo de la acción usado como "spot" para calcular la TNA/TEA: 24hs | CI
GGAL_SPOT_SETTLEMENT=24hs
# Cuántos vencimientos de futuro mostrar (2 = los dos más cercanos; 0 = todos)
GGAL_MAX_FUTURES=2
# Acciones ordinarias por ADR (GGAL = 10). Usado para el dólar implícito (CCL).
GGAL_ADR_RATIO=10

# ─────────────────────────────────────────────────────────────
#  Tasa teórica (cost of carry) y CCL por bonos
# ─────────────────────────────────────────────────────────────
# Plazo (días) de la caución en pesos usada como tasa libre de riesgo.
CAUCION_DAYS=7
# Caución corta (días): referencia de los futuros de tasa CAUC.
CAUCION_SHORT_DAYS=1
# Acciones del ETF GLD por onza de oro: el spot de ORO se estima como GLD × factor.
ORO_GLD_FACTOR=10.91
# Diferencia de TNA (fracción: 0.02 = 2 puntos) que debe superarse entre la punta del
# futuro y la TNA teórica para mostrar el cartel de COMPRA / VENTA.
GGAL_SIGNAL_THRESHOLD=0.02
# Bonos para el CCL (pesos / dólar cable) y su plazo: 24hs | CI
CCL_BOND_ARS=AL30
CCL_BOND_USD=AL30C
CCL_BOND_SETTLEMENT=24hs

# ─────────────────────────────────────────────────────────────
#  Alpaca Market Data — ADR de GGAL (NYSE/NASDAQ)
#  OPCIONAL. Sin estas keys, el ADR no se muestra (el resto funciona).
#  Cuenta gratis en https://alpaca.markets  → el plan free usa el feed IEX.
# ─────────────────────────────────────────────────────────────
# Finnhub (finnhub.io, free) — quote consolidado del ADR (precio/%, = TradingView)
FINNHUB_KEY=
# Alpaca — solo para el gráfico intradía del ADR (velas de Finnhub son premium)
ALPACA_KEY=
ALPACA_SECRET=
# Feed de datos: iex (gratis) | sip (consolidado, pago)
ALPACA_FEED=iex
# Ticker del ADR en Alpaca
ALPACA_ADR_SYMBOL=GGAL

# ─────────────────────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Orígenes permitidos por CORS. En dev "*" está bien; en producción poné
# la URL de tu front en Netlify, ej. https://ggal.netlify.app
CORS_ORIGINS=*
