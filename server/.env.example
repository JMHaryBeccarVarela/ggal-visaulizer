# ─────────────────────────────────────────────────────────────
#  Primary API (pyRofex) — acción GGAL (BYMA) + futuros GGAL (ROFX)
#  OBLIGATORIO. Credenciales de tu broker en Primary (broker Veta).
# ─────────────────────────────────────────────────────────────
PRIMARY_USER=
PRIMARY_PASS=
PRIMARY_ACCOUNT=

# URLs de Primary (Producción - broker Veta)
PRIMARY_REST_URL=https://api.veta.xoms.com.ar/
PRIMARY_WS_URL=wss://api.veta.xoms.com.ar/

# ─────────────────────────────────────────────────────────────
#  Instrumentos GGAL
# ─────────────────────────────────────────────────────────────
# Ticker de la acción en BYMA (se descubren los plazos CI y 24hs solos).
GGAL_EQUITY_TICKER=GGAL
# marketId de los futuros en Primary.
GGAL_FUTURES_MARKET=ROFX
# Plazo de la acción usado como "spot" para calcular la TNA/TEA: 24hs | CI
GGAL_SPOT_SETTLEMENT=24hs
# Cuántos vencimientos de futuro mostrar (2 = los dos más cercanos; 0 = todos)
GGAL_MAX_FUTURES=2
# Acciones ordinarias por ADR (GGAL = 10). Usado para el dólar implícito (CCL).
GGAL_ADR_RATIO=10

# ─────────────────────────────────────────────────────────────
#  Alpaca Market Data — ADR de GGAL (NYSE/NASDAQ)
#  OPCIONAL. Sin estas keys, el ADR no se muestra (el resto funciona).
#  Cuenta gratis en https://alpaca.markets  → el plan free usa el feed IEX.
# ─────────────────────────────────────────────────────────────
ALPACA_KEY=
ALPACA_SECRET=
# Feed de datos: iex (gratis) | sip (consolidado, pago)
ALPACA_FEED=iex
# Ticker del ADR en Alpaca
ALPACA_ADR_SYMBOL=GGAL

# ─────────────────────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
