{
  "name": "derivados",
  "version": "0.2.0",
  "description": "GGAL en tiempo real — ADR / BYMA / Futuros + widget de escritorio",
  "author": "D&G",
  "private": true,
  "main": "electron/main.cjs",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "py -muvicorn app.main:app --app-dir server --host 0.0.0.0 --port 8080 --reload --reload-dir server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w client",
    "install:server": "py -mpip install -r server/requirements.txt",
    "start": "npm run dev",
    "widget": "electron electron/main.cjs",
    "dist:widget": "electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ggal.widget",
    "productName": "GGAL Widget",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "GGAL-Widget.exe"
    }
  }
}
